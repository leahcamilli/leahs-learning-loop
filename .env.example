# Telegram capture interface
TELEGRAM_BOT_TOKEN=
ALLOWED_TELEGRAM_USER_ID=

# Lesson generation via Codex CLI + ChatGPT monthly-plan auth
# Install: npm install -g @openai/codex
# Auth once on the Mac mini: codex login  (Sign in with ChatGPT)
# Do NOT set OPENAI_API_KEY — usage should bill to the ChatGPT plan.
CODEX_BIN=codex
CODEX_MODEL=gpt-5.4
CODEX_TIMEOUT_SECONDS=300
# Optional override of the auth cache directory (default: ~/.codex)
# CODEX_HOME=

# Canonical Markdown publishing
GITHUB_TOKEN=
GITHUB_REPOSITORY=leahcamilli/leahs-learning-loop
GITHUB_BRANCH=master
LEARNING_LOOP_SITE_URL=https://leahcamilli.github.io/leahs-learning-loop/

# Capture behavior
CAPTURE_TIMEZONE=America/Chicago
MIN_WEB_SOURCE_CHARS=800
MIN_YOUTUBE_SOURCE_CHARS=1500
YOUTUBE_FETCH_TIMEOUT_SECONDS=60

# Optional: TypeSafe Jev judgments (source gate, takeaway grounding, topics, profile)
# Put the real key only in .env.local on the capture host.
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest
JEV_SOURCE_MIN=0.15
JEV_SUPPORT_MIN=0.3
JEV_TOPIC_MIN=0.5
